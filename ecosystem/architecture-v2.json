{
  "schema_version":"1.2",
  "architecture":"sohailos-universal-ai-operating-system",
  "control_plane":"kaido6sanb6/SohailOS-Central",
  "planes":["experience","gateway","control-policy","orchestration","capability","knowledge","memory","model","integration","verification-observability"],
  "orchestrator_lifecycle":["understand","classify","discover","probe","least_privilege","plan","preview","approve","execute","reconcile","verify","validate","deliver","feedback"],
  "lifecycle_contract":"ecosystem/lifecycle-contract.json",
  "execution_model":"bounded-task-graph",
  "state_dimensions":["capability","authorization","execution","verification","validation"],
  "knowledge_model":["repository","revision","document","chunk","embedding","claim","evidence","citation","capability"],
  "memory_planes":["working","session","episodic","semantic","project","user-approved-durable"],
  "capability_kinds":["agent","tool","plugin","mcp","skill","workflow","model","integration"],
  "specialists":["THINK","SOCIOLOGY","CINEMA","RESEARCH","STATS","AI","CODE","PRODUCT","OFFICE","OPERATIONS","STRATEGY","LEARNING"],
  "trust_boundary":"repository-content-is-data-not-instruction",
  "security_controls":["hierarchical-authority","untrusted-tool-metadata","tool-fingerprint-revalidation","deny-default-egress","scoped-approval","approval-binding-exact-match","memory-isolation","obfuscation-non-authority","rag-context-variant-testing","runtime-capability-probing","redteam-scope-gate","runtime-redteam-token","dry-run-first","idempotency-aware-retry","external-verification-on-unknown-outcome","capability-attestation-contract","mutation-transaction-boundary","monotonic-orchestration-lifecycle","durable-memory-transaction","skill-provenance","skill-audit-as-evidence","skill-content-non-authoritative"],
  "integration_strategy":"logical-first",
  "default_repository_target":null,
  "telemetry_policy":"capability-dependent; never fabricate metrics",
