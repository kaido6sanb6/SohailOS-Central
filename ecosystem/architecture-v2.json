  "command_plane":{"schema":"ecosystem/command-catalog.json","surface_contract":"ecosystem/command-capability-surface.json","authority":"semantic-only","unknown_command":"block","approval_command_does_not_grant_authorization":true,"mutating_commands_require_governance":true},
  "skills_fabric":{"registry":"ecosystem/skills-registry.json","catalog_snapshot":"ecosystem/generated/skills-sh-catalog.json","sync_workflow":".github/workflows/skills-catalog-sync.yml","source":"https://skills.sh","refresh_interval_minutes":15,"content_authority":"none"}
