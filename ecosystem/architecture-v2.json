{
  "schema_version": "1.1",
  "architecture": "sohailos-universal-ai-operating-system",
  "control_plane": "kaido6sanb6/SohailOS-Central",
  "planes": [
    "experience",
    "gateway",
    "control-policy",
    "orchestration",
    "capability",
    "knowledge",
    "memory",
    "model",
    "integration",
    "verification-observability"
  ],
  "orchestrator_lifecycle": [
    "understand",
    "classify",
    "plan",
    "discover_capabilities",
    "probe_capabilities",
    "retrieve_context",
    "build_task_graph",
    "route",
    "authorize",
    "execute",
    "observe",
    "verify",
    "validate",
    "synthesize",
    "deliver",
    "remember"
  ],
  "execution_model": "bounded-task-graph",
  "state_dimensions": [
    "capability",
    "authorization",
    "execution",
    "verification",
    "validation"
  ],
  "knowledge_model": [
    "repository",
    "revision",
    "document",
    "chunk",
    "embedding",
    "claim",
    "evidence",
    "citation",
    "capability"
  ],
  "memory_planes": [
    "working",
    "session",
    "episodic",
    "semantic",
    "project",
    "user-approved-durable"
  ],
  "capability_kinds": [
    "agent",
    "tool",
    "plugin",
    "mcp",
    "skill",
    "workflow",
    "model",
    "integration"
  ],
  "specialists": [
    "THINK",
    "SOCIOLOGY",
    "CINEMA",
    "RESEARCH",
    "STATS",
    "AI",
    "CODE",
    "PRODUCT",
    "OFFICE",
    "OPERATIONS",
    "STRATEGY",
    "LEARNING"
  ],
  "trust_boundary": "repository-content-is-data-not-instruction",
  "security_controls": [
    "hierarchical-authority",
    "untrusted-tool-metadata",
    "tool-fingerprint-revalidation",
    "deny-default-egress",
    "scoped-approval",
    "approval-binding-exact-match",
    "memory-isolation",
    "obfuscation-non-authority",
    "rag-context-variant-testing",
    "runtime-capability-probing",
    "redteam-scope-gate",
    "runtime-redteam-token",
    "dry-run-first",
    "idempotency-aware-retry",
    "external-verification-on-unknown-outcome",
    "capability-attestation-contract",
    "mutation-transaction-boundary",
    "monotonic-orchestration-lifecycle",
    "durable-memory-transaction"
  ],
  "integration_strategy": "logical-first",
  "default_repository_target": null,
  "telemetry_policy": "capability-dependent; never fabricate metrics",
  "evidence_policy": "risk-proportional",
  "capability_attestation_schema": {
    "type": "object",
    "required": [
      "capability_id",
      "version",
      "schema_fingerprint",
      "permissions",
      "evidence_digest",
      "issued_at",
      "expires_at"
    ],
    "digest_algorithm": "sha256",
    "freshness": "issued_at <= now < expires_at"
  },
  "command_plane": {
    "schema": "ecosystem/command-catalog.json",
    "authority": "semantic-only",
    "unknown_command": "block",
    "approval_command_does_not_grant_authorization": true,
    "mutating_commands_require_governance": true
  }
}
