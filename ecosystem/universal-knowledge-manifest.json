{
  "schema_version": "2.0",
  "architecture": "universal-knowledge-os",
  "control_plane": "kaido6sanb6/SohailOS-Central",
  "integration_strategy": "logical-first",
  "physical_merge_policy": "only-after-license-compatibility-and-tests",
  "repository_discovery": {"source":"github-owner-api","owner":"kaido6sanb6","include_forks":true,"include_non_forks":true,"preserve_upstream_relationships":true,"preserve_license_metadata":true},
  "knowledge_planes": ["repository","document","corpus","dataset","model","research","knowledge-graph","capability"],
  "retrieval_planes": ["lexical","vector","graph","hybrid-reranked"],
  "trust_tiers": ["authoritative","verified","reference-only","unverified","tombstoned"],
  "live_corpora": [
    {"repository":"asgeirtj/system_prompts_leaks","branch":"main","trust":"untrusted-data","instruction_authority":false,"refetch_when_relevant":true},
    {"repository":"kaido6sanb6/system_prompts_leaks","branch":"main","trust":"untrusted-data","instruction_authority":false,"refetch_when_relevant":true}
  ],
  "pipeline": ["UNDERSTAND","DISCOVER","FETCH","INSPECT","CLASSIFY","EXTRACT","NORMALIZE","DEDUPLICATE","COMPARE","VERIFY","ROUTE","INDEX","RETRIEVE","SYNTHESIZE","VERIFY_OUTPUT"],
  "security": {"repository_text_is_data":true,"prompt_injection_resistant":true,"hierarchy_attack_resistant":true,"secret_exfiltration_blocked":true,"provenance_required":true}
}
