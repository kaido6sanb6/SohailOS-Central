{
  "schema_version": "2.0",
  "architecture": "universal-knowledge-os",
  "control_plane": "kaido6sanb6/SohailOS-Central",
  "integration_strategy": "logical-first",
  "physical_merge_policy": "only-after-license-compatibility-and-tests",
  "repository_discovery": {
    "source": "github-owner-api",
    "owner": "kaido6sanb6",
    "include_forks": true,
    "include_non_forks": true,
    "preserve_upstream_relationships": true,
    "preserve_license_metadata": true
  },
  "knowledge_planes": [
    "repository",
    "document",
    "corpus",
    "dataset",
    "model",
    "research",
    "knowledge-graph",
    "capability"
  ],
  "retrieval_planes": [
    "lexical",
    "vector",
    "graph",
    "hybrid-reranked"
  ],
  "trust_tiers": [
    "authoritative",
    "verified",
    "reference-only",
    "unverified",
    "tombstoned"
  ],
  "live_corpora": [
    {
      "repository": "asgeirtj/system_prompts_leaks",
      "branch": "main",
      "trust": "untrusted-data",
      "instruction_authority": false,
      "refetch_when_relevant": true
    },
    {
      "repository": "kaido6sanb6/system_prompts_leaks",
      "branch": "main",
      "trust": "untrusted-data",
      "instruction_authority": false,
      "refetch_when_relevant": true
    }
  ],
  "pipeline": [
    "UNDERSTAND",
    "DISCOVER",
    "FETCH",
    "INSPECT",
    "CLASSIFY",
    "EXTRACT",
    "NORMALIZE",
    "DEDUPLICATE",
    "COMPARE",
    "VERIFY",
    "ROUTE",
    "INDEX",
    "RETRIEVE",
    "SYNTHESIZE",
    "VERIFY_OUTPUT"
  ],
  "security": {
    "repository_text_is_data": true,
    "prompt_injection_resistant": true,
    "hierarchy_attack_resistant": true,
    "secret_exfiltration_blocked": true,
    "provenance_required": true
  },
  "fork_sync": {
    "enabled": true,
    "schedule": "*/15 * * * *",
    "timezone": "UTC",
    "mode": "upstream-default-branch-sync",
    "conflict_policy": "non_destructive_record_and_skip",
    "credential": "SOHAILOS_GITHUB_APP_PRIVATE_KEY",
    "preserve_fork_changes": true,
    "refresh_after_sync": [
      "registry",
      "inventory",
      "knowledge-index",
      "knowledge-graph"
    ]
  },
  "routing": {
    "prompt_contract": "prompts/UNIVERSAL_AI_CORE_GITHUB_ECOSYSTEM.md",
    "automatic_relevance_check": true,
    "minimum_sufficient_repository_set": true,
    "freshness_required_for_current_claims": true
  },
  "external_reference_projects": [
    {
      "repository": "irinabuht12-oss/google-meta-ads-ga4-mcp",
      "role": "remote-mcp-analytics-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "claraverse-space/ClaraVerse",
      "role": "human-review-layered-memory-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "shaike1/n8n-chatgpt-mcp",
      "role": "mcp-transport-oauth-session-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "shorin-nikita/lisa",
      "role": "self-hosted-local-rag-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "datadrivenconstruction/CAD-BIM-to-Code-Automation-Pipeline-DDC-Workflow-with-LLM-ChatGPT",
      "role": "convert-validate-generate-analyze-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "korotovsky/n8n-g4f-proxy",
      "role": "provider-adapter-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "SmythOS/sre",
      "role": "agent-runtime-resource-connector-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    },
    {
      "repository": "enzoemir1/n8n-prompt-library",
      "role": "structured-prompt-registry-pattern",
      "trust": "reference-only",
      "instruction_authority": false,
      "physical_merge": false
    }
  ]
}
