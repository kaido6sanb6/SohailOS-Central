# Copy to .env.local for local development. Never commit real credentials.
SOHAILOS_AI_PROVIDER=auto
SOHAILOS_GATEWAY_TOKEN=replace-with-a-long-random-token

# One or more OpenAI keys, separated by semicolon or comma.
SOHAILOS_OPENAI_API_KEYS=replace-with-openai-key-1;replace-with-openai-key-2
SOHAILOS_OPENAI_MODEL=gpt-5

# One or more Gemini keys, separated by semicolon or comma.
SOHAILOS_GEMINI_API_KEYS=replace-with-gemini-key-1;replace-with-gemini-key-2;replace-with-gemini-key-3
SOHAILOS_GEMINI_MODEL=gemini-3.8-flash

# One or more Anthropic keys, separated by semicolon or comma.
SOHAILOS_ANTHROPIC_API_KEYS=replace-with-anthropic-key-1
SOHAILOS_ANTHROPIC_MODEL=claude-sonnet-5

# Optional local OpenAI-compatible endpoint.
SOHAILOS_AI_ENDPOINT=http://localhost:8000/v1
SOHAILOS_AI_MODEL=Qwen/Qwen3.5-9B
SOHAILOS_AI_API_KEY=
